# Dockerfile.cuda - PocketTTS OpenAI-Compatible Server with CUDA support
# Requires NVIDIA Container Toolkit on the host:
#   https://docs.nvidia.com/datacenter/cloud-native/container-toolkit/install-guide.html
#
# Uses CUDA 11.8 + PyTorch <=2.4.1 for broad GPU compatibility, including
# Pascal-generation cards (GTX 1060/1070/1080, Titan Xp, Tesla P100 — sm_61/sm_62).
# PyTorch 2.5+ dropped Pascal support; CUDA 12.x dropped sm_61 kernel images.
#
# Build:
#   docker build -f Dockerfile.cuda -t pockettts-openai-server:cuda .
#
# Run:
#   docker run --gpus all -p 49112:49112 pockettts-openai-server:cuda

FROM nvidia/cuda:11.8.0-cudnn8-devel-ubuntu22.04 AS builder

# Install Python 3.10 and build deps.
#
# Old nvidia/cuda base images require a three-step APT bootstrap to work with
# a current Ubuntu 22.04 mirror.  Two separate problems must be fixed:
#
# 1. Unknown NVIDIA source filename: the CUDA apt source file in
#    /etc/apt/sources.list.d/ has a name that varies by image version (e.g.
#    cuda-ubuntu2204-x86_64.list, nvidia-machine-learning.list, etc.). Guessing
#    specific filenames is fragile.  We wipe the entire directory; the Ubuntu
#    archive repos we actually need are in /etc/apt/sources.list and are
#    unaffected.  All CUDA libraries needed at runtime are already baked into
#    the base image layers, so no NVIDIA apt source is required here.
#
# 2. Stale GPG keyrings: the base image was built in 2022; Ubuntu rotated their
#    archive signing key after that.  Stale keys exist in TWO places:
#      a) /etc/apt/trusted.gpg  (legacy binary keyring)
#      b) /etc/apt/trusted.gpg.d/  (per-package .gpg files from ubuntu-keyring)
#    Both must be wiped.  With an empty keyring every repo is "insecure", so the
#    first apt-get update runs with AllowInsecureRepositories=true; we then install
#    the current ubuntu-keyring package (--allow-unauthenticated), whose postinst
#    script writes the post-rotation Ubuntu archive key to trusted.gpg.d/.  The
#    second apt-get update runs normally and all signatures verify correctly.
RUN find /etc/apt/sources.list.d/ -type f -delete \
    && rm -f /etc/apt/trusted.gpg \
    && find /etc/apt/trusted.gpg.d/ -type f -delete \
    && apt-get -o Acquire::AllowInsecureRepositories=true update \
    && apt-get install -y --allow-unauthenticated --no-install-recommends \
        ubuntu-keyring \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        python3.10 \
        python3.10-venv \
        python3-pip \
        build-essential \
    && rm -rf /var/lib/apt/lists/*

# Create virtual environment
RUN python3.10 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Install Python dependencies (CUDA-enabled PyTorch)
COPY requirements-cuda.txt /tmp/requirements-cuda.txt
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r /tmp/requirements-cuda.txt


# Production image
FROM nvidia/cuda:11.8.0-cudnn8-runtime-ubuntu22.04

# Install Python 3.10 and runtime dependencies for audio processing.
# See the builder stage comment above for a full explanation of the three-step
# APT bootstrap required by old NVIDIA CUDA base images: wipe sources.list.d/,
# trusted.gpg, and trusted.gpg.d/; insecure-update + unauthenticated ubuntu-keyring
# install; then a clean verified update.
RUN find /etc/apt/sources.list.d/ -type f -delete \
    && rm -f /etc/apt/trusted.gpg \
    && find /etc/apt/trusted.gpg.d/ -type f -delete \
    && apt-get -o Acquire::AllowInsecureRepositories=true update \
    && apt-get install -y --allow-unauthenticated --no-install-recommends \
        ubuntu-keyring \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        python3.10 \
        python3.10-venv \
        libsndfile1 \
        ffmpeg \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Copy virtual environment from builder
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Create non-root user
RUN useradd --create-home --shell /bin/bash pockettts
WORKDIR /app

# Copy application code
COPY --chown=pockettts:pockettts app/ ./app/
COPY --chown=pockettts:pockettts static/ ./static/
COPY --chown=pockettts:pockettts templates/ ./templates/
COPY --chown=pockettts:pockettts voices/ ./voices/
COPY --chown=pockettts:pockettts server.py ./

# Create logs directory, and ensure app directory is owned by user
RUN chown pockettts:pockettts /app && mkdir -p /app/logs && chown pockettts:pockettts /app/logs

# Create HuggingFace cache directory (for volume mount)
RUN mkdir -p /home/pockettts/.cache/huggingface && \
    chown -R pockettts:pockettts /home/pockettts/.cache

# Switch to non-root user
USER pockettts

# Environment variables with defaults
ENV POCKET_TTS_HOST=0.0.0.0 \
    POCKET_TTS_PORT=49112 \
    POCKET_TTS_VOICES_DIR=/app/voices \
    POCKET_TTS_LOG_DIR=/app/logs \
    POCKET_TTS_LOG_LEVEL=INFO \
    POCKET_TTS_DEVICE=cuda \
    PYTHONUNBUFFERED=1

# Expose port
EXPOSE 49112

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD python3.10 -c "import urllib.request; urllib.request.urlopen('http://localhost:49112/health')" || exit 1

# Run server
CMD ["python3.10", "server.py"]
